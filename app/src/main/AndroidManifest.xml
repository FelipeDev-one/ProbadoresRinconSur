<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cámara (HU-08): permiso PELIGROSO. Se DECLARA aquí y además se PIDE
         en tiempo de ejecución (ver permisos/Permisos.kt y FueraServicioScreen). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Vibración para las alertas urgentes (RF-07). Es un permiso normal:
         Android lo concede solo, no se le pregunta al usuario. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- La galería se abre con el selector de fotos del sistema (Photo Picker),
         que NO necesita permisos de almacenamiento (RNF-06: pedimos lo mínimo). -->

    <!-- La app usa la cámara, pero no es obligatoria: sin cámara se puede elegir de la galería. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- allowBackup="false": los RUT y nombres de colaboradores no salen del equipo (RNF-06). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProbadoresRinconSur"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ProbadoresRinconSur"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider: entrega a la app de cámara una dirección (content://) donde
             guardar la foto, sin exponer las carpetas privadas de la app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
